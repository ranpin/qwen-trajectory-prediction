# Alpamayo-edge deploy config (source before running Orin scripts):
#   set -a && . configs/orin.env && set +a
ORIN_HOST=vision@30.245.40.99      # ssh 别名 orin-dog(勾) 含中文括号，用 user@ip
MODEL=nvidia/Alpamayo-R1-10B       # edge-supported version (NOT 1.5)
